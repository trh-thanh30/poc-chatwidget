{
  "name": "poc-chatwidget",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=22.0.0 <23"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:api": "pnpm --filter @chat-widget/api dev",
    "dev:widget": "pnpm --filter @chat-widget/widget dev",
    "dev:demo": "pnpm --filter @chat-widget/demo dev",
    "build": "pnpm --recursive --if-present run build",
    "build:api": "pnpm --filter @chat-widget/api build",
    "build:widget": "pnpm --filter @chat-widget/widget build",
    "build:demo": "pnpm --filter @chat-widget/demo build",
    "lint": "eslint .",
    "check-types": "pnpm --recursive --if-present run check-types",
    "check-types:api": "pnpm --filter @chat-widget/api check-types",
    "check-types:widget": "pnpm --filter @chat-widget/widget check-types",
    "check-types:demo": "pnpm --filter @chat-widget/demo check-types",
    "test": "vitest run",
    "format": "prettier --write .",
    "infra:dev:up": "docker compose -f docker-compose.dev.yml up -d --wait db redis",
    "infra:dev:down": "docker compose -f docker-compose.dev.yml down",
    "infra:dev:logs": "docker compose -f docker-compose.dev.yml logs -f db redis",
    "infra:dev:ps": "docker compose -f docker-compose.dev.yml ps",
    "infra:dev:config": "docker compose -f docker-compose.dev.yml config",
    "db:generate": "pnpm --filter @chat-widget/api db:generate",
    "db:migrate": "pnpm --filter @chat-widget/api db:migrate",
    "db:seed": "pnpm --filter @chat-widget/api db:seed",
    "db:studio": "pnpm --filter @chat-widget/api db:studio"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/node": "^22.10.7",
    "eslint": "^9.39.2",
    "globals": "^16.5.0",
    "jsdom": "^27.2.0",
    "prettier": "^3.7.4",
    "turbo": "^2.6.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4",
    "vitest": "^4.0.10"
  }
}
