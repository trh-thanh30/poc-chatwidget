{
  "name": "poc-chatwidget",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=22.0.0 <23"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "pnpm --recursive --if-present run build",
    "lint": "eslint .",
    "check-types": "pnpm --recursive --if-present run check-types",
    "test": "vitest run",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/node": "^22.10.7",
    "eslint": "^9.39.2",
    "globals": "^16.5.0",
    "jsdom": "^27.2.0",
    "prettier": "^3.7.4",
    "turbo": "^2.6.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4",
    "vitest": "^4.0.10"
  }
}
