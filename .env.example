# Application
NODE_ENV=development
PORT=3000

# Local PostgreSQL (keep DATABASE_URL aligned when overriding the values below)
POSTGRES_DB=poc_chatwidget
POSTGRES_USER=poc_chatwidget_user
POSTGRES_PASSWORD=poc_chatwidget_password
DEV_DB_PORT=15432
DATABASE_URL=postgresql://poc_chatwidget_user:poc_chatwidget_password@127.0.0.1:15432/poc_chatwidget

# Local Redis (queue-ready infrastructure; no BullMQ consumer is registered yet)
REDIS_PASSWORD=poc_chatwidget_redis_password
DEV_REDIS_PORT=16379
REDIS_URL=redis://:poc_chatwidget_redis_password@127.0.0.1:16379

# Widget session defaults used by the next backend capability
WIDGET_SESSION_JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes
WIDGET_SESSION_JWT_TTL_SECONDS=900
CHAT_CHANNEL=mock
